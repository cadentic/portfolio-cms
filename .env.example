# Optional overrides for `docker compose up`. Copy to .env (git-ignored).
# Everything works without this file; these are the defaults.

# Owner account created in the local Firebase Auth emulator and allowed into /admin.
LOCAL_ADMIN_EMAIL=owner@cadentic.dev
LOCAL_ADMIN_PASSWORD=localpass123

# Signs unsubscribe/confirmation tokens. Any 32+ character string locally.
APP_SECRET=local-development-secret-not-for-production-use

# Host ports (change any that are already taken on your machine; on Windows,
# Hyper-V/WSL can reserve ranges: `netsh interface ipv4 show excludedportrange protocol=tcp`).
DB_PORT=5432
AUTH_PORT=9099
MOCK_PORT=8025
API_PORT=8080

# Path INSIDE the api container to your resume PDF, if you mount one, e.g.
# add `volumes: ["./private/resume.pdf:/data/resume.pdf:ro"]` to the api service.
RESUME_FILE_PATH=

# Google Contacts list (Admin -> Subscribers & Email -> Google Contacts). OAuth web
# client with redirect URI http://localhost:4000/api/google/oauth/callback;
# see docs/google-contacts.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
