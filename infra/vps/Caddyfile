# Serves the site on its hostnames (site_host, plus www when it is served)
# with automatic HTTPS (Let's Encrypt, HTTP-01). The DNS records must point at
# this server first; the dns/ Terraform root does that when the deploy
# playbook switches DNS.
{$SITE_ADDRESSES} {
	encode zstd gzip
	# Uploads are capped at MEDIA_MAX_UPLOAD_MB (30 MB by default) by the API;
	# refuse anything far larger here before it reaches the app.
	request_body {
		max_size 40MB
	}
	# Don't advertise the server software. The app sets CSP, HSTS and the
	# other security headers itself.
	header -Server
	reverse_proxy web:4000 {
		header_down -X-Powered-By
	}
}
