# secret.tfvars: every secret and account setting for a cloud deploy.
# Copy to infra/terraform/secret.tfvars (git-ignored) and fill in the values.
# The same file serves every Terraform root (gcp/, azure/, vps/, dns/,
# media-gcs/ and media-azure/); settings a root does not use are ignored.
#
# Never commit the real file. Terraform state also contains these values, so
# keep state in an encrypted remote backend (see the backend comment in main.tf).

# The Cloudflare zone and the email sending domain. SPF, DMARC and the Brevo
# and Mailjet records always stay here.
domain = "cadentic.dev"

# Where the site is served. Empty: the domain itself (cadentic.dev, plus www).
# A subdomain such as "profile.cadentic.dev" moves only the site records there;
# the mail records stay on the domain. site_www adds www.<site_host>; leave it
# unset for the default (yes on the domain itself, no on a subdomain).
site_host = ""
# site_www = false

# --- Neon Postgres ---------------------------------------------------------------
# Create the database yourself in the Neon console, then copy the *direct*
# connection string (Connect > turn "Connection pooling" off, so the host has no
# "-pooler"): the API's start-up migrations use session locks, which Neon's
# pooler does not support. The API creates its tables on first start.
database_url = "postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/portfolio?sslmode=require"

# 32+ random characters, e.g. `openssl rand -base64 48`. Changing it invalidates
# pending confirmation and unsubscribe links.
app_secret = "REPLACE_WITH_48_RANDOM_BYTES_BASE64"

# --- Owner sign-in (Firebase Auth) ------------------------------------------------
# Firebase console > Project settings > General > Your apps (Web app config).
firebase_project_id  = "your-firebase-project"
firebase_api_key     = "AIza..."
firebase_auth_domain = "your-firebase-project.firebaseapp.com"
# Accounts allowed into /admin. Add the site host (cadentic.dev, or site_host such as
# profile.cadentic.dev) to Firebase Auth > Settings > Authorized domains.
admin_emails = "you@example.com"
admin_uids   = ""
# Private address for delivery alerts (never shown on the site).
admin_alert_email = "you@example.com"

# --- Email providers -----------------------------------------------------------------
email_from_address = "newsletter@cadentic.dev"

# Brevo (primary): Settings > SMTP & API > API keys.
email_brevo_api_key = "xkeysib-..."
# Any long random string. Use it as the password in the Brevo webhook URL
# (on the site host, e.g. profile.cadentic.dev when site_host is set):
#   https://webhook:<secret>@cadentic.dev/api/webhooks/brevo
email_brevo_webhook_secret = "REPLACE_WITH_RANDOM_STRING"

# Mailjet (secondary): Account settings > REST API > API key management.
email_mailjet_api_key    = "..."
email_mailjet_secret_key = "..."
#   https://webhook:<secret>@cadentic.dev/api/webhooks/mailjet
email_mailjet_webhook_secret = "REPLACE_WITH_RANDOM_STRING"

# DKIM and verification records shown by Brevo (Senders, domains > Authenticate)
# and Mailjet (Account settings > Domains). SPF and DMARC are created for you.
email_dns_records = [
  # { name = "brevo1._domainkey.cadentic.dev", type = "CNAME", content = "b1.cadentic-dev.dkim.brevo.com" },
  # { name = "brevo2._domainkey.cadentic.dev", type = "CNAME", content = "b2.cadentic-dev.dkim.brevo.com" },
  # { name = "cadentic.dev",                  type = "TXT",   content = "brevo-code:xxxxxxxx" },
  # { name = "mailjet._domainkey.cadentic.dev", type = "TXT", content = "k=rsa; p=MIGf..." },
  # { name = "mailjet._xxxxxxxx.cadentic.dev",  type = "TXT", content = "xxxxxxxxxxxx" },
]
dmarc_policy = "quarantine"
dmarc_rua    = ""

# --- Analytics (optional; loaded only after visitor consent) --------------------------
gtm_id             = ""
ga4_measurement_id = ""

# --- Google Contacts sync (optional) ---------------------------------------------------
# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application).
# Redirect URI: https://cadentic.dev/api/google/oauth/callback (your site host).
# Enable the People API; publish the consent screen ("In production"). docs/google-contacts.md
google_oauth_client_id     = ""
google_oauth_client_secret = ""

# --- Cloudflare (DNS for cadentic.dev) -------------------------------------------------
# My Profile > API Tokens > Create token > "Edit zone DNS", limited to cadentic.dev.
cloudflare_api_token = "..."
# Domain overview page, right column.
cloudflare_zone_id = "..."

# --- Google Cloud Run (target: gcp) ------------------------------------------------------
gcp_project_id = "your-gcp-project"
gcp_region     = "asia-southeast1"

# --- Azure Container Apps (target: azure) ------------------------------------------------
azure_subscription_id = "00000000-0000-0000-0000-000000000000"
azure_location        = "centralindia"
acr_name              = "cadenticportfolio"

# --- Any VPS with root SSH (target: vps) ---------------------------------------------------
# A Bluehost VPS or dedicated server (shared hosting cannot run Docker), Hetzner,
# DigitalOcean, Lightsail... Pick a plain Ubuntu or AlmaLinux image without cPanel,
# and set up SSH key login first (ssh-copy-id root@<ip>). The playbook installs
# Docker and runs the stack behind Caddy, which gets the HTTPS certificates.
vps_ipv4     = "" # public IPv4 address; the domain's A record points here
vps_ipv6     = "" # optional
vps_ssh_user = "root" # a non-root user needs passwordless sudo
vps_ssh_port = 22
# Run PostgreSQL 18 on the server instead of Neon. Copy the data over with
#   python3 tools/cloudmigrate/cloudmigrate.py move --to vps --db-to vps
vps_local_db    = false
vps_db_password = "" # 16+ characters, e.g. `openssl rand -hex 24`

# --- Media bucket (uploads and the WordPress images) ----------------------------------------
# A private bucket that only the site can read and write; visitors get files
# through the site. It can sit in another Google Cloud project or Azure
# subscription than the site. "local" keeps files in a volume on the VPS
# (Cloud Run and Container Apps discard local files, so use a bucket there).
media_storage = "local" # local | gcs | azure

# Google Cloud Storage (media_storage = "gcs"). The project can differ from gcp_project_id.
media_gcs_bucket     = "" # globally unique, e.g. "cadentic-portfolio-media"
media_gcs_project_id = "" # empty: gcp_project_id
media_gcs_location   = "asia-southeast1"

# Azure Blob Storage (media_storage = "azure"). Same Entra tenant as the site.
media_azure_account         = "" # 3-24 lowercase letters/digits, e.g. "cadenticmedia"
media_azure_container       = "media"
media_azure_subscription_id = "" # empty: azure_subscription_id
media_azure_resource_group  = "rg-portfolio-media"
media_azure_location        = "centralindia"

# A site in the bucket's own cloud uses its own identity, with no key. A site
# elsewhere (a VPS, or Azure with a Google bucket and the other way round)
# needs a key limited to this bucket. Turn it on for that, and keep it on until
# a move between clouds is finished.
media_access_key = false
