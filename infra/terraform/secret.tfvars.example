# secret.tfvars: every secret and account setting for a cloud deploy.
# Copy to infra/terraform/secret.tfvars (git-ignored) and fill in the values.
# The same file serves both targets (gcp/ and azure/); settings for the other
# cloud are ignored with a warning.
#
# Never commit the real file. Terraform state also contains these values, so
# keep state in an encrypted remote backend (see the backend comment in main.tf).

domain = "cadentic.dev"

# --- Neon Postgres ---------------------------------------------------------------
# Create the database yourself in the Neon console (Connection details, pooled
# connection string). The API creates its tables on first start.
database_url = "postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/portfolio?sslmode=require"

# 32+ random characters, e.g. `openssl rand -base64 48`. Changing it invalidates
# pending confirmation and unsubscribe links.
app_secret = "REPLACE_WITH_48_RANDOM_BYTES_BASE64"

# --- Owner sign-in (Firebase Auth) ------------------------------------------------
# Firebase console > Project settings > General > Your apps (Web app config).
firebase_project_id  = "your-firebase-project"
firebase_api_key     = "AIza..."
firebase_auth_domain = "your-firebase-project.firebaseapp.com"
# Accounts allowed into /admin. Add cadentic.dev to Firebase Auth > Settings > Authorized domains.
admin_emails = "you@example.com"
admin_uids   = ""
# Private address for delivery alerts (never shown on the site).
admin_alert_email = "you@example.com"

# --- Email providers -----------------------------------------------------------------
email_from_address = "newsletter@cadentic.dev"

# Brevo (primary): Settings > SMTP & API > API keys.
email_brevo_api_key = "xkeysib-..."
# Any long random string. Use it as the password in the Brevo webhook URL:
#   https://webhook:<secret>@cadentic.dev/api/webhooks/brevo
email_brevo_webhook_secret = "REPLACE_WITH_RANDOM_STRING"

# Mailjet (secondary): Account settings > REST API > API key management.
email_mailjet_api_key    = "..."
email_mailjet_secret_key = "..."
#   https://webhook:<secret>@cadentic.dev/api/webhooks/mailjet
email_mailjet_webhook_secret = "REPLACE_WITH_RANDOM_STRING"

# DKIM and verification records shown by Brevo (Senders, domains > Authenticate)
# and Mailjet (Account settings > Domains). SPF and DMARC are created for you.
email_dns_records = [
  # { name = "brevo1._domainkey.cadentic.dev", type = "CNAME", content = "b1.cadentic-dev.dkim.brevo.com" },
  # { name = "brevo2._domainkey.cadentic.dev", type = "CNAME", content = "b2.cadentic-dev.dkim.brevo.com" },
  # { name = "cadentic.dev",                  type = "TXT",   content = "brevo-code:xxxxxxxx" },
  # { name = "mailjet._domainkey.cadentic.dev", type = "TXT", content = "k=rsa; p=MIGf..." },
  # { name = "mailjet._xxxxxxxx.cadentic.dev",  type = "TXT", content = "xxxxxxxxxxxx" },
]
dmarc_policy = "quarantine"
dmarc_rua    = ""

# --- Analytics (optional; loaded only after visitor consent) --------------------------
gtm_id             = ""
ga4_measurement_id = ""

# --- Cloudflare (DNS for cadentic.dev) -------------------------------------------------
# My Profile > API Tokens > Create token > "Edit zone DNS", limited to cadentic.dev.
cloudflare_api_token = "..."
# Domain overview page, right column.
cloudflare_zone_id = "..."

# --- Google Cloud Run (target: gcp) ------------------------------------------------------
gcp_project_id = "your-gcp-project"
gcp_region     = "asia-southeast1"

# --- Azure Container Apps (target: azure) ------------------------------------------------
azure_subscription_id = "00000000-0000-0000-0000-000000000000"
azure_location        = "centralindia"
acr_name              = "cadenticportfolio"
